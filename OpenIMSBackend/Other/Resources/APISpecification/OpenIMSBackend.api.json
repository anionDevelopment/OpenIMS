            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/API/v0/UserController/Login": {
      "put": {
        "tags": [
          "User"
        ],
        "summary": "Authenticates a user with the given credentials and returns an access token on success.",
        "parameters": [
          {
            "name": "user",
            "in": "header",
            "description": "The username.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "password",
            "in": "header",
            "description": "The plain-text password.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            }
          }
        }
      }
