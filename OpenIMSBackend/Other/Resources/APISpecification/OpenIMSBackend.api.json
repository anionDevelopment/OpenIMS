  "components": {
    "schemas": {
      "AccessToken": {
        "type": "object",
        "properties": {
          "ownerUserId": {
            "type": "string",
            "nullable": true
          },
          "value": {
            "type": "string",
            "nullable": true
          },
          "expiredMoment": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "GeneralSettingsDTO": {
        "type": "object",
        "properties": {
          "registrationIsEnabled": {
            "type": "boolean",
            "description": "Whether a new user-account can be created at all."
          }
        },
        "additionalProperties": false,
        "description": "Data transfer object for the general (admin-configurable) OpenIMS-settings."
      },
      "IdLabelDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "label": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Identifies an object by its id and describes it by a human-readable label, for example as an entry of a selection-list."
      },
      "StringValueDTO": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Transports a single string-value, so that an endpoint which only exchanges one value does not need a type of its own."
      },
      "UserInformationDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "isAdmin": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "description": "Represents the information about the currently authenticated user which the frontend needs to render itself."
      },
      "UserOverviewDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "roles": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Represents a user together with the names of the roles currently assigned to it. Used for the administrative user-overview."
      }
    }
  },
  "tags": [
    {
      "name": "MaintenanceRoutes"
    },
    {
      "name": "OpenIMSBackend"
    },
    {
      "name": "User"
    }
  ]
