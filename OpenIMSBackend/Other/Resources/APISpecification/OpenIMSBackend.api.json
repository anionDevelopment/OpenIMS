    "/API/v1/OpenIMSBackend/SearchInventoryObjects": {
      "get": {
        "tags": [
          "OpenIMSBackend"
        ],
        "summary": "Searches the inventory-objects of the given types whose name contains the given text (ignoring the case). The amount of results is limited, so this is meant to be called while the user types. Requires administrator privileges.",
        "parameters": [
          {
            "name": "searchText",
            "in": "query",
            "description": "The text which the name has to contain. An empty text matches every name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "types",
            "in": "query",
            "description": "The types of the objects which are searched: \"Location\", \"Building\", \"Area\", \"Container\" and/or \"Item\".",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "X-AccessToken",
            "in": "header",
            "description": "Access Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IdLabelDTO"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IdLabelDTO"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IdLabelDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
