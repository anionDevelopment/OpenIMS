            }
          }
        }
      }
    },
    "/API/v0/OpenIMSBackend/AssignGroupToAuthorizableItem": {
      "put": {
        "tags": [
          "OpenIMSBackend"
        ],
        "summary": "Assigns the given group to the given inventory-object, so that its members get read-access to the object and to everything which is in it. Requires administrator privileges.",
        "parameters": [
          {
            "name": "groupName",
            "in": "query",
            "description": "The name of the group.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "authorizableItemId",
            "in": "query",
            "description": "The id of the inventory-object.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-AccessToken",
            "in": "header",
            "description": "Access Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/API/v0/OpenIMSBackend/RemoveGroupFromAuthorizableItem": {
      "put": {
        "tags": [
          "OpenIMSBackend"
        ],
        "summary": "Removes the assignment of the given group to the given inventory-object. Requires administrator privileges.",
        "parameters": [
          {
            "name": "groupName",
            "in": "query",
            "description": "The name of the group.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "authorizableItemId",
            "in": "query",
            "description": "The id of the inventory-object.",
