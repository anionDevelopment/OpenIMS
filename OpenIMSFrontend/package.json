{
  "name": "open-ims",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build-QualityCheck",
    "build-Development": "ng build --configuration Development",
    "build-QualityCheck": "ng build --configuration QualityCheck",
    "build-Productive": "ng build --configuration Productive",
    "test": "npm run test-QualityCheck",
    "test-Development": "ng test --configuration Development --watch false",
    "test-QualityCheck": "ng test --configuration QualityCheck --watch false",
    "test-Productive": "ng test --configuration Productive --watch false",
    "start": "ng serve --configuration Development --host 0.0.0.0 --live-reload=false --allowed-hosts=true",
    "lint": "ng lint",
    "extract-translations": "ng extract-i18n"
  },
  "dependencies": {
    "@angular/animations": "22.1.1",
    "@angular/cdk": "22.1.1",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/localize": "22.1.1",
    "@angular/material": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-browser-dynamic": "22.1.1",
    "@angular/router": "22.1.1",
    "@aniondev/ngx-culture-selector": "0.1.1",
    "@aniondev/ngx-darkmode-toggle-button": "2.0.2",
    "@fontsource/material-icons": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/schematics": "19.0.2",
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "angular-eslint": "19.2.0",
    "eslint": "9.21.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.15.0",
    "vitest": "4.1.11"
  }
}